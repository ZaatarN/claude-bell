{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/play.py\" \"${CLAUDE_PLUGIN_ROOT}/sounds/done.mp3\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/play.py\" \"${CLAUDE_PLUGIN_ROOT}/sounds/done.mp3\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/play.py\" \"${CLAUDE_PLUGIN_ROOT}/sounds/attention.mp3\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/play.py\" \"${CLAUDE_PLUGIN_ROOT}/sounds/attention.mp3\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/play.py\" \"${CLAUDE_PLUGIN_ROOT}/sounds/permission.mp3\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/play.py\" \"${CLAUDE_PLUGIN_ROOT}/sounds/permission.mp3\" 2>/dev/null; exit 0"
          }
        ]
      }
    ]
  }
}
